{
  "name": "@chatbot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest --passWithNoTests",
    "lint": "eslint src test --ext .ts",
    "prisma:generate": "node ../../scripts/with-root-env.mjs prisma generate",
    "prisma:migrate": "node ../../scripts/with-root-env.mjs prisma migrate dev",
    "prisma:deploy": "node ../../scripts/with-root-env.mjs prisma migrate deploy",
    "prisma:studio": "node ../../scripts/with-root-env.mjs prisma studio",
    "prisma:seed": "node ../../scripts/with-root-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@chatbot/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@chatbot/shared$": "<rootDir>/../../packages/shared/src"
    },
    "collectCoverageFrom": ["src/**/*.(t|j)s"],
    "testEnvironment": "node"
  }
}
