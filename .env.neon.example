# Copy this file to .env when you want to use Neon instead of local Docker Postgres.
# Never commit the real .env file.

# Neon pooled connection string, recommended for apps/serverless.
# Example shape:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# API
API_PORT=4000
ADMIN_API_TOKEN="replace-with-a-long-random-token"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Optional AI fallback
OPENAI_API_KEY=""
AI_CLASSIFICATION_ENABLED=false

# Admin app
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
ADMIN_SERVER_API_TOKEN="replace-with-the-same-value-as-ADMIN_API_TOKEN"
